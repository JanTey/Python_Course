import os

class DataManager:
    def __init__(self, filename="dzivnieki.txt"):
        # Привязываем путь к файлу к папке программы
        base_dir = os.path.dirname(os.path.abspath(__file__))
        self.file_path = os.path.join(base_dir, filename)

    def save_animal(self, suga, vards, vecums):
        """Запись данных в файл в формате: суга|имя|возраст"""
        data_line = f"{suga}|{vards}|{vecums}\n"
        with open(self.file_path, "a", encoding="utf-8") as f:
            f.write(data_line)
        return True

    def get_all_animals(self):
        """Чтение всех данных из файла"""
        if not os.path.exists(self.file_path):
            return []
        
        animals = []
        with open(self.file_path, "r", encoding="utf-8") as f:
            for line in f:
                parts = line.strip().split("|")
                if len(parts) == 3:
                    animals.append(parts)
        return animals